# Copy this file to backend/.env and fill in your Facebook app's credentials to enable
# "Continue with Facebook". backend/.env is ignored by git — never commit your app secret.
# Get them at https://developers.facebook.com/apps -> your app -> App settings -> Basic.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Only needed when the app is deployed somewhere other than localhost, e.g. https://findyourmate.example.com
# APP_URL=http://localhost:5000

# ---- Email (password reset links) --------------------------------------------------------------------------
# Without these, reset emails aren't sent — the link is printed in the backend terminal instead (fine for testing).
# Gmail: turn on 2-Step Verification, then create an App password at https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=abcdefghijklmnop
# MAIL_FROM=FindYourMate <you@gmail.com>
